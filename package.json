{
  "name": "sehat-saheli-care-loop",
  "version": "0.2.0",
  "description": "A care-coordination prototype that helps ASHA workers, families, and PHC teams close referral and follow-up loops.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerdskp/sehat-saheli-dtl.git"
  },
  "homepage": "https://github.com/nerdskp/sehat-saheli-dtl#readme",
  "bugs": {
    "url": "https://github.com/nerdskp/sehat-saheli-dtl/issues"
  },
  "keywords": [
    "asha",
    "community-health",
    "care-coordination",
    "design-thinking-lab",
    "healthcare"
  ],
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently --names frontend,backend --prefix-colors cyan,magenta \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:frontend": "npm run typecheck --workspace frontend",
    "typecheck:backend": "npm run typecheck --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
